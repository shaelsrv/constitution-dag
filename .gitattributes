# Dump + role-spec data files are checksummed; their bytes must be identical on
# every platform. Force LF so SHA256SUMS matches on Windows checkouts too, and
# never let autocrlf rewrite them (which silently breaks the checksums in CI).
dumps/**/*.jsonl   text eol=lf
dumps/**/SHA256SUMS text eol=lf
dumps/**/manifest.json text eol=lf
role_spec/**/*.jsonl text eol=lf
role_spec/**/manifest.json text eol=lf
