# Everything under dumps/ and role_spec/ is checksummed (SHA256SUMS), so the bytes
# must be identical on every platform. Force LF on the WHOLE tree — data and docs
# alike — so a Windows checkout's autocrlf can't silently rewrite a byte and break
# the checksums in CI. (This is exactly the bug that failed PR #1's first run.)
dumps/**       text eol=lf
role_spec/**   text eol=lf
